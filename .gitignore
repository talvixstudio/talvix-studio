# ==========================================
# TALVIX STUDIO - .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# ==========================================
# ENVIRONMENT VARIABLES / SECRETS
# Nunca enviar credenciais para o GitHub
# ==========================================

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

# Cloudflare / Wrangler secrets
.dev.vars
.dev.vars.*
.wrangler/

# ==========================================
# BUILD / GENERATED FILES
# ==========================================

dist/
dist-ssr/
.output/
.vinxi/
.tanstack/
.nitro/
coverage/

# ==========================================
# LOGS
# ==========================================

logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# LOCAL FILES
# ==========================================

*.local

# ==========================================
# EDITORS / IDE
# ==========================================

.vscode/*
!.vscode/extensions.json
.idea/

*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# OPERATING SYSTEM
# ==========================================

.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# TEMPORARY / CACHE FILES
# ==========================================

*.tmp
*.temp
*.cache
.cache/
.temp/
tmp/

# ==========================================
# LOCAL DATABASE / CREDENTIAL FILES
# ==========================================

credentials.json
service-account.json
serviceAccount.json
secrets.json
